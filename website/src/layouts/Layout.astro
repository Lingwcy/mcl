---
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/manrope";
import "@fontsource/space-mono/latin-400.css";
import "@fontsource/space-mono/latin-700.css";
import "../styles/global.css";
import { copy, type Locale } from "../content/site";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  alternateEn?: string;
  alternateZh?: string;
}

const {
  locale,
  title,
  description,
  alternateEn = "/",
  alternateZh = "/zh/",
} = Astro.props;
const t = copy[locale];
const pageTitle = title ? `${title} — ${t.brandFull}` : t.title;
const pageDescription = description ?? t.description;
const siteUrl = Astro.site;
const canonical = siteUrl ? new URL(Astro.url.pathname, siteUrl).href : undefined;
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#111111" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Meow Craft Launcher" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={locale === "zh" ? "zh_CN" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {siteUrl && (
      <>
        <link rel="canonical" href={canonical} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={new URL("/social.svg", siteUrl).href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="mcl — Meow Craft Launcher." />
        <link rel="alternate" hreflang="en" href={new URL(alternateEn, siteUrl).href} />
        <link rel="alternate" hreflang="zh-CN" href={new URL(alternateZh, siteUrl).href} />
        <link rel="alternate" hreflang="x-default" href={new URL(alternateEn, siteUrl).href} />
      </>
    )}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="expect" href="#main" blocking="render" />
    <title>{pageTitle}</title>
    <ClientRouter />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{t.skip}</a>
    <div class="top-notice" role="region" aria-label={t.announcement.badge} data-top-notice>
      <div class="top-notice-inner">
        <span class="top-notice-badge">{t.announcement.badge}</span>
        <span class="top-notice-text">{t.announcement.text}</span>
        <button
          type="button"
          class="top-notice-code"
          data-notice-copy="932894666"
          data-copy-text={t.announcement.code}
          data-copied-text={t.announcement.copiedLabel}
          aria-label={t.announcement.copyLabel}
          title={t.announcement.copyLabel}
        >
          <span data-notice-code-label>{t.announcement.code}</span>
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 9h10v10H9V9Zm-4 6H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" />
          </svg>
        </button>
      </div>
      <button
        type="button"
        class="top-notice-close"
        data-notice-close
        aria-label={t.announcement.closeLabel}
        title={t.announcement.closeLabel}
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m6 6 12 12M6 18 18 6" />
        </svg>
      </button>
    </div>
    <slot />
    <script>
      let noticeCleanup: AbortController | null = null;
      const NOTICE_STORAGE_KEY = "mcl:notice-dismissed-qq932894666";

      function initTopNotice() {
        noticeCleanup?.abort();
        noticeCleanup = new AbortController();
        const { signal } = noticeCleanup;

        const bar = document.querySelector<HTMLElement>("[data-top-notice]");
        if (!bar) return;

        try {
          if (window.sessionStorage.getItem(NOTICE_STORAGE_KEY) === "1") {
            bar.hidden = true;
            return;
          }
        } catch {
          // Ignore storage access errors.
        }

        const copyBtn = bar.querySelector<HTMLButtonElement>("[data-notice-copy]");
        const copyLabelEl = bar.querySelector<HTMLElement>("[data-notice-code-label]");
        let timer = 0;

        copyBtn?.addEventListener(
          "click",
          async () => {
            const value = copyBtn.dataset.noticeCopy ?? "";
            const defaultText = copyBtn.dataset.copyText ?? "QQ:932894666";
            const copiedText = copyBtn.dataset.copiedText ?? "Copied";
            if (!value) return;
            try {
              await navigator.clipboard.writeText(value);
              if (copyLabelEl) copyLabelEl.textContent = copiedText;
              copyBtn.classList.add("is-copied");
              window.clearTimeout(timer);
              timer = window.setTimeout(() => {
                if (copyLabelEl) copyLabelEl.textContent = defaultText;
                copyBtn.classList.remove("is-copied");
              }, 1600);
            } catch {
              // Ignore clipboard permission errors.
            }
          },
          { signal }
        );

        const closeBtn = bar.querySelector<HTMLButtonElement>("[data-notice-close]");
        closeBtn?.addEventListener(
          "click",
          () => {
            bar.hidden = true;
            try {
              window.sessionStorage.setItem(NOTICE_STORAGE_KEY, "1");
            } catch {
              // Ignore storage quota errors.
            }
          },
          { signal }
        );
      }

      document.addEventListener("astro:page-load", initTopNotice);
      document.addEventListener("astro:before-swap", () => {
        noticeCleanup?.abort();
        noticeCleanup = null;
      });
    </script>
  </body>
</html>
