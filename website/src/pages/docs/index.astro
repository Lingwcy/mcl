---
import { render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { getDocsByLocale } from "../../lib/docs";

const items = await getDocsByLocale("en");
const current = items.find((item) => item.slug === "") ?? items[0];
if (!current) {
  throw new Error("No English documentation entries found.");
}
const { Content, headings } = await render(current.entry);
---

<DocsLayout locale="en" entry={current.entry} slug={current.slug} headings={headings}>
  <Content />
</DocsLayout>
